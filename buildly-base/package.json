{
  "name": "buildly-premium",
  "version": "1.0.0",
  "description": "Sistema Operacional para Infraestrutura Pesada",
  "author": "Buildly Team",
  "license": "Proprietary",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "install:all": "pnpm install",
    "build": "pnpm -r build",
    "build:prod": "pnpm -r build -- --prod",
    "dev": "pnpm -r dev",
    "start": "docker-compose up -d && pnpm -r start",
    "stop": "docker-compose down",
    "restart": "docker-compose restart",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r test:e2e",
    "test:coverage": "pnpm -r test -- --coverage",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint -- --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "db:migrate": "supabase migration up",
    "db:reset": "docker-compose exec -T postgres psql -U buildly_user -d buildly_db -c \"DROP SCHEMA public CASCADE; CREATE SCHEMA public;\"",
    "db:backup": "./scripts/infrastructure.sh db-backup",
    "db:restore": "./scripts/infrastructure.sh db-restore",
    "logs": "./scripts/infrastructure.sh logs",
    "status": "./scripts/infrastructure.sh status",
    "health": "./scripts/infrastructure.sh health-check",
    "clean": "pnpm -r clean && pnpm -r store prune"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.2.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.5.0",
    "prettier": "^2.8.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.0.3",
    "uuid": "^9.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.6.0"
}
