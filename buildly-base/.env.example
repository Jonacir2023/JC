# 🔐 Buildly Premium — Environment Variables
# Copy to .env and fill with actual values
# NEVER commit .env file to git

# ===== DATABASE =====
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=buildly_db
PG_USER=buildly_user
PG_PASSWORD=buildly_secure_password_2026
PG_POOL_SIZE=20

# ===== NEO4J =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password_2026
NEO4J_DB=neo4j

# ===== REDIS =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== NODE ENVIRONMENT =====
NODE_ENV=development
# Options: development, staging, production

# ===== API CONFIGURATION =====
API_PORT=3001
API_HOST=localhost
API_VERSION=v1
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRY=24h

# ===== BRAIN ML ENGINE =====
ML_ENGINE_PORT=3002
ML_ENGINE_HOST=localhost

# ===== DECISION RECORDING API =====
DECISION_API_PORT=3003
DECISION_API_HOST=localhost

# ===== LOGGING =====
LOG_LEVEL=info
LOG_FORMAT=json

# ===== CACHE =====
CACHE_TTL=86400
CACHE_MAX_SIZE=1000

# ===== PILOT CONFIGURATION =====
PILOT_ENABLED=true
PILOT_SITES=5
PILOT_PHASE=4.3

# ===== SECURITY =====
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ===== TEMPORAL/SCHEDULING =====
TIMEZONE=America/Sao_Paulo
