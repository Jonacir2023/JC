# Buildly Premium — Production Environment
# DO NOT COMMIT SECRETS — Use vault/secrets manager

# ============================================
# Core API
# ============================================
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# ============================================
# Brain ML Engine
# ============================================
BRAIN_ML_URL=http://brain-ml:3002
BRAIN_API_TOKEN=${BRAIN_API_TOKEN}  # From vault

# ============================================
# PostgreSQL
# ============================================
PG_HOST=postgres-prod.c.buildly.cloud
PG_PORT=5432
PG_DATABASE=buildly_prod
PG_USER=buildly_prod_user
PG_PASSWORD=${PG_PASSWORD}  # From vault
PG_POOL_MIN=10
PG_POOL_MAX=50
PG_SSL_MODE=require

# ============================================
# Redis
# ============================================
REDIS_URL=redis://:${REDIS_PASSWORD}@redis-prod.c.buildly.cloud:6379/0
REDIS_CLUSTER_MODE=true
REDIS_SENTINEL_NODES=sentinel-1,sentinel-2,sentinel-3

# ============================================
# Monitoring
# ============================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
SENTRY_DSN=${SENTRY_DSN}  # From vault

# ============================================
# Security
# ============================================
JWT_SECRET=${JWT_SECRET}  # From vault
API_KEY_SECRET=${API_KEY_SECRET}  # From vault
CORS_ORIGINS=https://buildly.app,https://admin.buildly.app

# ============================================
# Feature Flags
# ============================================
FEATURE_MATERIAL_DELAY_ALERTS=true
FEATURE_AUTO_APPROVAL=false
FEATURE_PILOT_MODE=true

# ============================================
# Audit & Compliance
# ============================================
AUDIT_ENABLED=true
GDPR_COMPLIANCE=true
DATA_RETENTION_DAYS=730
