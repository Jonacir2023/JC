  "technology_stack": {
    "languages": [
      "TypeScript (primary)",
      "Python (IA/ML)",
      "Node.js (runtime)",
      "SQL (queries)"
    ],
    "backend": [
      "NestJS (core-api)",
      "FastAPI (ia-engine)",
      "Express (api-gateway)",
      "Bull.js (job queue)"
    ],
    "frontend": [
      "React (web dashboard)",
      "React Native (mobile, Phase 4)"
    ],
    "databases": [
      "PostgreSQL 15 (event store + state)",
      "Neo4j 5.x (graph)",
      "Redis 7 (cache)",
      "Qdrant (vector db)"
    ],
    "messaging": [
      "NATS (message bus)",
      "Bull.js + Redis (job queue)"
    ],
    "infrastructure": [
      "Docker Compose (local)",
      "Kubernetes (production, Phase 3+)",
      "GitHub Actions (CI/CD)"
    ],
    "monitoring": [
      "Prometheus",
      "Loki",
      "Jaeger",
      "Grafana"
    ]
  },
  "code_patterns": {
    "naming": {
      "domain_variables": "Portuguese (obra_id, evento_id, atividade_id)",
      "infrastructure_variables": "English (user_id, timestamp, version)",
      "interfaces": "Prefix I (IEvent, IObjective, IDecision)",
      "builders": "Suffix Builder (EventBuilder, ObjectiveBuilder)"
    },
    "architecture": {
      "pattern": "DDD (Domain-Driven Design)",
      "structure": "Monorepo (pnpm workspaces)",
      "abstraction": "Event Sourcing + CQRS",
      "communication": "Event-driven async",
      "testing": "Unit + Integration + E2E"
    }
  },
  "deployment": {
    "local_development": {
      "command": "docker compose up -d",
      "services": 11,
      "startup_time": "~30 seconds"
    },
    "environments": {
      "development": "Local Docker Compose",
      "staging": "Kubernetes (Phase 3+)",
      "production": "Kubernetes (Phase 3+)"
    },
    "scaling": {
      "current": "Single-server (Phase 1)",
      "future": "Kubernetes auto-scaling (Phase 3+)"
    }
  },
  "api_overview": {
    "base_url": "http://localhost:3001",
    "auth": "JWT Bearer tokens",
    "versioning": "URL path /v1/, /v2/",
    "formats": "JSON (REST), GraphQL (Phase 3+)",
    "rate_limiting": "1000 req/min per API key"
  },
  "critical_files": {
    "architecture": "ARCHITECTURE_HANDBOOK.md",
    "setup": "buildly-premium/CLAUDE.md",
    "phase_4_3": "buildly-premium/PHASE-4.3-STATUS.md",
    "week_1": "buildly-premium/WEEK-1-EXECUTION.md",
    "phase_4_4": "buildly-premium/PHASE-4.4-SOFT-LAUNCH.md"
  }
}
