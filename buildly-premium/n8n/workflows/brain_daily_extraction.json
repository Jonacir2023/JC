{
  "name": "Buildly Brain Daily Extraction",
  "nodes": [
    {
      "parameters": {
        "triggerType": "every",
        "unit": "hours",
        "value": 24,
        "minutesAfterHour": 0
      },
      "name": "Daily Trigger (02:00 UTC)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeCommand",
        "command": "python /app/buildly-premium/scripts/brain_extraction_pipeline.py"
      },
      "name": "Execute Brain Extraction",
      "type": "n8n-nodes-base.bash",
      "typeVersion": 1,
      "position": [
        300,
        300
      ],
      "credentials": {
        "bash": "server_credentials"
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5432",
        "authentication": "genericCredentialType",
        "genericCredentialType": "psqlCredentials",
        "queryParameters": {}
      },
      "name": "Log Extraction Results",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        500,
        300
      ],
      "credentials": {
        "postgres": "buildly_db"
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "{{ $node[\"Execute Brain Extraction\"].json.exitCode }}",
              "operation": "notEqual",
              "value2": 0
            }
          ]
        }
      },
      "name": "Check for Errors",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "channel": "#buildly-alerts",
        "text": "❌ Brain Extraction Failed\n\nError: {{ $node[\"Execute Brain Extraction\"].json.stderr }}\n\nAction: Check logs and retry manually",
        "credentialsSecret": "slack_webhook"
      },
      "name": "Alert on Failure (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "channel": "#buildly-insights",
        "text": "✅ Brain Updated\n\nLessons processed: {{ $node[\"Log Extraction Results\"].json.lessons_count }}\nLessons with 'sucesso': {{ $node[\"Log Extraction Results\"].json.successful_count }}\nAvg confidence: {{ $node[\"Log Extraction Results\"].json.avg_confidence }}\n\nBrain now contains: {{ $node[\"Log Extraction Results\"].json.total_lessons }} lessons"
      },
      "name": "Notify Success (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [
        900,
        400
      ]
    }
  ],
  "connections": {
    "Daily Trigger (02:00 UTC)": {
      "main": [
        [
          {
            "node": "Execute Brain Extraction",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Brain Extraction": {
      "main": [
        [
          {
            "node": "Log Extraction Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Extraction Results": {
      "main": [
        [
          {
            "node": "Check for Errors",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check for Errors": {
      "main": [
        [
          {
            "node": "Notify Success (Slack)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alert on Failure (Slack)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "errorHandler": "Continue"
  },
  "versionId": "1",
  "meta": {
    "instanceId": "buildly-production"
  },
  "description": "Daily job: Extract lessons from latest RDO and update Buildly Brain (Neo4j) at 02:00 UTC"
}
