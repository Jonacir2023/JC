# Phase 3: ML Engine & Persistence Layer Configuration
# Copy to .env and fill with real values

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=buildly_db
PG_USER=buildly_user
PG_PASSWORD=change_me_in_production
PG_POOL_MIN=5
PG_POOL_MAX=20

# Neo4j
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_in_production
NEO4J_DATABASE=neo4j

# ML Engine Settings
ML_FEATURIZER_VERSION=1.0
ML_MODEL_REGISTRY_PATH=/tmp/models
ML_TRAINING_BATCH_SIZE=128
ML_INFERENCE_BATCH_SIZE=32

# XGBoost Hyperparameters
XGBOOST_N_ESTIMATORS=100
XGBOOST_MAX_DEPTH=6
XGBOOST_LEARNING_RATE=0.1
XGBOOST_SUBSAMPLE=0.8
XGBOOST_COLSAMPLE_BYTREE=0.8

# Optuna Tuning
OPTUNA_N_TRIALS=50
OPTUNA_N_JOBS=4
OPTUNA_TIMEOUT=3600

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/buildly/ml-engine.log

# Monitoring
MONITORING_ENABLED=true
MONITORING_PORT=8000
MONITORING_INTERVAL=60

# Environment
ENVIRONMENT=development
DEBUG=false
