# Multi-stage Dockerfile for Intelligence Layer

# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY apps/intelligence-layer/package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY apps/intelligence-layer/src ./src
COPY apps/intelligence-layer/tsconfig.json ./
COPY apps/intelligence-layer/.env.example ./.env.example

# Build TypeScript
RUN npm run build

# Stage 2: Runtime
FROM node:20-alpine

WORKDIR /app

# Install production dependencies only
COPY apps/intelligence-layer/package*.json ./
RUN npm ci --only=production && npm cache clean --force

# Copy built application from builder
COPY --from=builder /app/dist ./dist

# Copy configuration template
COPY apps/intelligence-layer/.env.example ./.env.example

# Create directories for models and logs
RUN mkdir -p /app/data/models /app/logs

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/recommendations/health', (r) => { if (r.statusCode !== 200) throw new Error(r.statusCode) })"

# Expose API port
EXPOSE 3001

# Environment
ENV NODE_ENV=production

# Run application
CMD ["node", "dist/main.js"]
