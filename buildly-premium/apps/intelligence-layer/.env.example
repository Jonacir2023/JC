# Intelligence Layer Configuration
# Phase 3.1: Recommendation Engine

## API Configuration
API_PORT=3001
NODE_ENV=development
CORS_ORIGIN=*

## PostgreSQL Connection
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=buildly
PG_USER=postgres
PG_PASSWORD=
PG_POOL_MIN=5
PG_POOL_MAX=20

## Neo4j Connection (optional)
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

## Model Configuration
MODEL_PATH=../../data/models
MODEL_CACHE_TTL=60000
INFERENCE_LATENCY_THRESHOLD_MS=200

## Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/var/log/buildly/intelligence-layer.log

## Monitoring
MONITORING_ENABLED=true
MONITORING_PORT=9090
METRICS_INTERVAL_SECONDS=60
