;; PostgreSQL Connection Pooler Configuration — pgBouncer
;; Phase 3.2: Connection Pooling Setup
;; Created: 2026-07-30
;; Purpose: Pool PostgreSQL connections to reduce overhead

[databases]
; Format: dbname = host=localhost dbname=actual_db port=5432
buildly = host=localhost dbname=buildly port=5432 user=postgres password=CHANGEME

[pgbouncer]
; Connection pooling configuration
pool_mode = transaction
; - session: returns to pool after client disconnects
; - transaction: returns to pool after transaction completes (RECOMMENDED for our use case)
; - statement: returns after each SQL statement

; Maximum number of connections per database
max_db_connections = 100

; Minimum number of idle connections to maintain
min_pool_size = 5

; Target pool size per database
default_pool_size = 20

; Maximum number of client connections
max_client_conn = 1000

; Reserve pool size for emergencies
reserve_pool_size = 5

; Seconds to wait for a new connection
reserve_pool_timeout = 3

; Connection lifetime (seconds)
max_lifetime = 3600

; Idle connection timeout
idle_in_transaction_session_timeout = 300

; TCP settings
tcp_keepalives = 1
tcp_keepidle = 30
tcp_keepintvl = 10
tcp_keepcnt = 5

; Logging
log_connections = 1
log_disconnections = 1
log_pooler_debug = 0
log_stats = 1
stats_period = 60

; Database monitoring
server_idle_timeout = 600
server_connection_initiation_timeout = 15
server_login_retry = 15

; Admin interface
admin_users = postgres
stats_users = postgres

; Server options
query_wait_timeout = 120
query_timeout = 0

; Disable nagle's algorithm for lower latency
tcp_defer_accept = 0
