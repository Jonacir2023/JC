# Buildly Integration Configuration
# ⚠️ NÃO COMMITAR CREDENCIAIS REAIS
# Use arquivo .env.local (gitignored) para valores de produção

# ============================================
# DESENVOLVIMENTO (Local)
# ============================================

# Core API
BUILDLY_CORE_API_DEV=http://localhost:3001
BUILDLY_CORE_HEALTH=http://localhost:3001/health

# Brain ML API
BUILDLY_BRAIN_API_DEV=http://localhost:3002
BUILDLY_BRAIN_HEALTH=http://localhost:3002/ml/health

# Database (Local)
BUILDLY_DB_HOST_DEV=localhost
BUILDLY_DB_PORT_DEV=5432
BUILDLY_DB_NAME_DEV=buildly
BUILDLY_DB_USER_DEV=buildly_user
BUILDLY_DB_PASSWORD_DEV=buildly_secure_password_2026

# Redis (Local)
BUILDLY_REDIS_HOST_DEV=localhost
BUILDLY_REDIS_PORT_DEV=6379
BUILDLY_REDIS_PASSWORD_DEV=buildly_redis_2026

# UIs (Local)
BUILDLY_PGADMIN_URL_DEV=http://localhost:5050
BUILDLY_PGADMIN_USER_DEV=admin@buildly.local
BUILDLY_PGADMIN_PASSWORD_DEV=admin

BUILDLY_REDIS_COMMANDER_URL_DEV=http://localhost:8081

# ============================================
# PRODUÇÃO (Cloud)
# ============================================

# APIs (Cloud)
BUILDLY_CORE_API_PROD=https://api.buildly.app
BUILDLY_BRAIN_API_PROD=https://brain.buildly.app

# Database (Cloud)
BUILDLY_DB_HOST_PROD=postgres-prod.c.buildly.cloud
BUILDLY_DB_PORT_PROD=5432
BUILDLY_DB_USER_PROD=
BUILDLY_DB_PASSWORD_PROD=

# Redis (Cloud)
BUILDLY_REDIS_HOST_PROD=redis-prod.c.buildly.cloud
BUILDLY_REDIS_PORT_PROD=6379
BUILDLY_REDIS_PASSWORD_PROD=

# API Credentials (Produção)
BUILDLY_API_KEY_PROD=
BUILDLY_API_SECRET_PROD=
